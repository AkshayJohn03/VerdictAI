# VerdictAI configuration. Copy to .env (or export the vars). All optional:
# with no API key VerdictAI runs fully offline using deterministic mocks.
VERDICTAI_API_KEY=
VERDICTAI_BASE_URL=https://api.openai.com/v1
VERDICTAI_MODEL=gpt-4o-mini
VERDICTAI_TEMPERATURE=0.0
VERDICTAI_MAX_TOKENS=1024
VERDICTAI_TIMEOUT_SECONDS=60
VERDICTAI_MAX_RETRIES=2
VERDICTAI_RETRY_BACKOFF_SECONDS=0.5
